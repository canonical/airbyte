Table "threads" {
    "id" string [pk, not null]
    "created_at" string [not null]
    "last_activity_at" string
    "integration_id" string
    "question_answers" object [not null]
    "has_more_question_answers" boolean
    "feedback" object
    "status_tag" object
    "custom_tags" object
    "interaction_tags" object
    "end_user" object
    "integration" object

    Note: "Kapa project threads. Nested question-answer, tag, user, feedback, and integration values are retained as JSON objects or arrays."
}

Table "activity" {
    "activity_date" string [pk, not null]
    "window_start" string [not null]
    "window_end" string [not null]
    "is_complete" boolean [not null]
    "aggregate_statistics" object [not null]
    "statistics_by_integration" object [not null]

    Note: "One aggregate record per UTC day. The current day ends at sync time and is refreshed on each sync; a one-day lookback updates recent completed totals."
}

Table "end_users" {
    "id" string [pk, not null]
    "display_id" string
    "email" string
    "unique_client_id" string
    "question_answer_count" integer
    "latest_thread_id" string
    "latest_thread_first_question" string
    "latest_activity_at" string
    "first_activity_at" string
    "company_name" string
    "created_at" string
    "google_sub_id" string
    "github_sub_id" string
    "kapa_oidc_sub_id" string

    Note: "Tracked project users. Identity and latest-thread context can contain personal data; fields vary with the configured Kapa integration."
}

Table "integrations" {
    "id" string [pk, not null]
    "project" string
    "name" string
    "description" string
    "integration_type" string
    "updated_at" string
    "created_at" string
}

Table "source_groups" {
    "id" string [pk, not null]
    "name" string [not null]
    "type" string [not null]
    "description" string
    "sub_groups" object
    "created_at" string
    "updated_at" string

    Note: "Product and version groups. sub_groups retains the nested source-group hierarchy."
}

Table "sources" {
    "id" string [pk, not null]
    "name" string
    "type" string
    "contains_internal_data" boolean
    "created_at" string
    "updated_at" string
    "source_groups" string
}

Table "top_questions_periods" {
    "id" string [pk, not null]
    "interval" string
    "start_date" string
    "end_date" string
    "total_conversations" integer
    "analytics_interval" string [not null]
}

Table "top_questions_clusters" {
    "period_id" string [not null]
    "id" string [not null]
    "title" string
    "summary" string
    "thread_count" integer
    "num_unique_users" integer
    "threads" object
    "analytics_interval" string [not null]

    indexes {
        (period_id, id) [pk]
    }

    Note: "Frequently asked question clusters. threads contains up to 100 recent thread summaries; thread_count is the authoritative total."
}

Table "coverage_gaps_periods" {
    "id" string [pk, not null]
    "interval" string
    "start_date" string
    "end_date" string
    "total_conversations" integer
    "analytics_interval" string [not null]
}

Table "coverage_gaps_clusters" {
    "period_id" string [not null]
    "id" string [not null]
    "title" string
    "summary" string
    "suggestion" string
    "thread_count" integer
    "num_unique_users" integer
    "threads" object
    "analytics_interval" string [not null]

    indexes {
        (period_id, id) [pk]
    }

    Note: "Uncertain-answer clusters with documentation suggestions. threads contains up to 100 recent thread summaries; thread_count is the authoritative total."
}

Ref: "top_questions_periods"."id" < "top_questions_clusters"."period_id"
Ref: "coverage_gaps_periods"."id" < "coverage_gaps_clusters"."period_id"
